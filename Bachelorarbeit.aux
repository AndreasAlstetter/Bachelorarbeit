\@writefile{lof}{\contentsline {figure}{\numberline {6.1}{\ignorespaces  Bildung eines Makroprofils am Beispiel des übergeordneten Motor-Makros M1\_F1\_V1. Die Trainingsartikel liefern die \textit  {technische Artikeleigenschaften}. Das Motor-Makro stellt die gemeinsamen \textit  {technischen Makroeigenschaften} bereit, die für alle Artikel der Artikelgruppe gelten. Das erzeugte Makroprofil wird anschließend im \texttt  {Suchraum\_Makroprofile} gespeichert. }}{48}{figure.caption.30}\protected@file@percent }
\newlabel{fig:makroprofil_motor}{{6.1}{48}{Bildung eines Makroprofils am Beispiel des übergeordneten Motor-Makros M1\_F1\_V1. Die Trainingsartikel liefern die \textit {technische Artikeleigenschaften}. Das Motor-Makro stellt die gemeinsamen \textit {technischen Makroeigenschaften} bereit, die für alle Artikel der Artikelgruppe gelten. Das erzeugte Makroprofil wird anschließend im \texttt {Suchraum\_Makroprofile} gespeichert}{figure.caption.30}{}}
\newlabel{fig:makroprofil_motor@cref}{{[figure][1][6]6.1}{[1][47][]48}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1.2}Anfrageprofil}{49}{subsection.6.1.2}\protected@file@percent }
\newlabel{sec:anfrageprofil}{{6.1.2}{49}{Anfrageprofil}{subsection.6.1.2}{}}
\newlabel{sec:anfrageprofil@cref}{{[subsection][2][6,1]6.1.2}{[1][48][]49}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces  Bildung eines Anfrageprofils am Beispiel eines Motorartikels. Im Unterschied zum Makroprofil beschreibt das Anfrageprofil nur einen einzelnen Artikel. Die verfügbaren technischen Artikel- und Makroeigenschaften werden übernommen, während die Artikel-Makro-Zuordnung und die eigene Makrobezeichnung als makroidentifizierende Informationen ausgeschlossen werden. Die erzeugten Anfrageprofile werden abhängig vom Datensplit in den Datensätzen \texttt  {Anfrageprofile\_Training}, \texttt  {Anfrageprofile\_Validierung} und \texttt  {Anfrageprofile\_Test} gespeichert. }}{50}{figure.caption.31}\protected@file@percent }
\newlabel{fig:anfrageprofil_motor}{{6.2}{50}{Bildung eines Anfrageprofils am Beispiel eines Motorartikels. Im Unterschied zum Makroprofil beschreibt das Anfrageprofil nur einen einzelnen Artikel. Die verfügbaren technischen Artikel- und Makroeigenschaften werden übernommen, während die Artikel-Makro-Zuordnung und die eigene Makrobezeichnung als makroidentifizierende Informationen ausgeschlossen werden. Die erzeugten Anfrageprofile werden abhängig vom Datensplit in den Datensätzen \texttt {Anfrageprofile\_Training}, \texttt {Anfrageprofile\_Validierung} und \texttt {Anfrageprofile\_Test} gespeichert}{figure.caption.31}{}}
\newlabel{fig:anfrageprofil_motor@cref}{{[figure][2][6]6.2}{[1][49][]50}{}{}{}}
