\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces Gesamtarchitektur des Empfehlungssystems von der Datenbasis bis zur Makroempfehlung. Nach dem Datensplit werden die erforderlichen Datenobjekte erzeugt. Training und iterative Validierung bestimmen die finale Konfiguration des LambdaMART-Modells. Das ausgewählte Modell wird anschließend getestet und danach zur Bewertung neuer Anfragen sowie zur Erzeugung einer nach Relevanz sortierten Makro-Rangliste verwendet. }}{54}{figure.caption.33}\protected@file@percent }
\newlabel{fig:prozessarchitektur_empfehlungssystem}{{6.4}{54}{Gesamtarchitektur des Empfehlungssystems von der Datenbasis bis zur Makroempfehlung. Nach dem Datensplit werden die erforderlichen Datenobjekte erzeugt. Training und iterative Validierung bestimmen die finale Konfiguration des LambdaMART-Modells. Das ausgewählte Modell wird anschließend getestet und danach zur Bewertung neuer Anfragen sowie zur Erzeugung einer nach Relevanz sortierten Makro-Rangliste verwendet}{figure.caption.33}{}}
\newlabel{fig:prozessarchitektur_empfehlungssystem@cref}{{[figure][4][6]6.4}{[1][53][]54}{}{}{}}
